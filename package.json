{
  "name": "nimkoes_tech_blog",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://nimkoes.github.io/tech-blog",
  "scripts": {
    "dev": "next dev",
    "prepare:content": "node scripts/migrate-content-metadata.mjs --index-only && node scripts/generate-image-metadata.mjs && node scripts/generate-og-images.mjs",
    "check:content": "node scripts/validate-content-index.mjs",
    "check:seo": "node scripts/check-seo-artifacts.mjs",
    "check": "npm run lint && npm run test && npm run build && npm run check:seo",
    "migrate:metadata": "node scripts/migrate-content-metadata.mjs --refresh-descriptions",
    "migrate:legacy": "node scripts/migrate-legacy-content.mjs",
    "build": "npm run prepare:content && npm run check:content && next build",
    "start": "node scripts/serve-export.mjs",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.77.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "serve": "^14.2.8",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
